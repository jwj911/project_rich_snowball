# ============================================
# 期货交流社区 — 环境变量配置模板
# 复制为 .env 后填入真实值
# ============================================

# --------------------------------------------
# 数据库配置（二选一）
# --------------------------------------------

# 方案 A：SQLite（零配置，适合开发/个人使用）
# DATABASE_URL=sqlite:///./futures_community.db

# 方案 B：PostgreSQL（需先 docker-compose up -d postgres）
DATABASE_URL=postgresql://futures:futures123@localhost:15432/futures_community

# --------------------------------------------
# JWT / 安全（⚠️ 生产环境必须修改！）
# --------------------------------------------
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------
# CORS 配置
# --------------------------------------------
# 推荐使用 CORS_ORIGINS；ALLOW_ORIGINS 作为旧兼容变量仍可使用
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3200,http://127.0.0.1:3200

# --------------------------------------------
# Redis 缓存（可选，留空则使用内存缓存）
# --------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# SSE 部署模式
# --------------------------------------------
# 非生产环境未设置时默认 single；生产环境必须显式设置 single 或 sticky
# single：仅由单个 API 实例承载 SSE；sticky：负载均衡必须保持同一用户命中同一实例
SSE_DEPLOYMENT_MODE=single

# --------------------------------------------
# 数据采集配置
# --------------------------------------------
# 数据源选择：mock / tushare / akshare
DATA_SOURCE=mock
# Tushare Pro Token（使用 tushare 数据源时必填）
TUSHARE_TOKEN=your-tushare-token-here
# 是否启用定时采集任务（1=启用，0=禁用）
# 开发环境可设为 1，让 API 进程同时跑采集；生产环境建议拆分为独立 worker，API 端设为 0
ENABLE_SCHEDULER=1

# --------------------------------------------
# 运行环境（development / production）
# --------------------------------------------
# development：启用 Swagger UI、自动插入 mock 数据
# production：关闭 Swagger UI、不插入 mock 数据
ENV=development

# --------------------------------------------
# 发布与 CSP 证据归属（可选）
# --------------------------------------------
# API 使用完整 Git SHA 为新 CSP 报告写入可信 release；非空时必须是 40 位十六进制
# 留空不会阻止 S1 报告接收，但对应记录不能形成 R10 ready_for_review 证据
RELEASE_COMMIT=

# --------------------------------------------
# 前端 API 地址（Next.js 构建时/运行时读取）
# --------------------------------------------
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8401

# --------------------------------------------
# CSP Report-Only 观测
# --------------------------------------------
# 合法报告的确定性采样率，必须在 0 到 1 之间；1 表示全部进入持久化尝试
CSP_REPORT_SAMPLE_RATE=1
# 可选：未设置时使用 NEXT_PUBLIC_API_BASE 的 origin + /api/log/csp-report
# 只允许无凭据、query、fragment 的绝对 HTTP(S) URL
# CSP_REPORT_URL=https://api.example.com/api/log/csp-report

# API 服务监听地址
# --------------------------------------------
# Windows 上 8200 端口可能被系统 TCP 排除端口段保留；默认使用 127.0.0.1:8401
HOST=127.0.0.1
PORT=8401
